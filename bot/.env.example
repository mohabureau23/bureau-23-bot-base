# BUREAU 23 Discord Bot - variables d'environnement
# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
WELCOME_CHANNEL_ID=
MEMBER_ROLE_ID=
LOG_CHANNEL_ID=

# Témoignages & staff
TESTIMONIAL_CHANNEL_ID=1544717170083242085
STAFF_ROLE_ID=1544719817909600357
# Optionnel : catégorie où créer les salons ticket
TICKET_CATEGORY_ID=

# API HTTP (mini-site admin + Bureau 23 Hub) — aucune valeur secrète ici
# Port d'écoute : fourni par l'hébergeur (PORT ou SERVER_PORT). Laisser vide en local.
PORT=
SERVER_PORT=
# Interface d'écoute (défaut 0.0.0.0, requis derrière un proxy)
HOST=
# URL publique du bot, utilisée pour les liens de témoignage (sans slash final)
PUBLIC_BASE_URL=
# Secret partagé avec le mini-site admin
ADMIN_API_SECRET=
# Secret partagé avec Bureau 23 Hub (header x-hub-secret)
HUB_API_SECRET=
# Clé de signature des jetons de témoignage (chaîne aléatoire longue)
TESTIMONIAL_TOKEN_SECRET=

# Optionnel : debug | info | warn | error (défaut: info)
LOG_LEVEL=
